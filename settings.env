# qBittorrent version: a release tag such as release-5.3.0 or release-5.2.4
QBT_TAG=release-5.3.0

# libtorrent version. master is the development branch, which is the only
# version with tracker connection reuse. RC_2_1 is the newest stable branch.
# A release tag such as v2.1.2 also works, but note that won't do conn reuse.
LT_TAG=master

# Leave empty to let the build script pick the C++ standard. Set to 20 only if
# a build fails with errors mentioning std::expected or get_unexpected.
CXX_STANDARD=

# Keep ON while LT_TAG=master. OFF only works once qBittorrent stops calling
# create_smart_ban_plugin (see README).
DEPRECATED_FUNCTIONS=ON

# Set OFF if the libtorrent step fails around libdatachannel, usrsctp or juice.
WEBTORRENT=ON

# Leave empty for the newest OpenSSL. Set to lts if a step fails with errors
# mentioning openssl/ or SSL_.
OPENSSL_TAG=

# Link-time optimisation. Set to no on machines with less than ~8 GB RAM, or if
# the build gets killed without an error message.
USE_LTO=yes
